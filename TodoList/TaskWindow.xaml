<Window x:Class="TodoList.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task" SizeToContent="WidthAndHeight" MinWidth="430" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
        <TextBlock Text="Title" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>
        <TextBlock Text="Description" Grid.Row="1" VerticalAlignment="Top" Margin="0,0,10,10"/>
        <TextBox x:Name="DescriptionBox" Grid.Row="1" Grid.Column="1" Height="75" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>
        <TextBlock Text="Due date" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <DatePicker x:Name="DueDatePicker" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>
        <TextBlock Text="Priority" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <ComboBox x:Name="PriorityBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"/>
        <TextBlock Text="Status" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <ComboBox x:Name="StatusBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Padding="16,7" Margin="0,8,8,0"/>
            <Button Content="Save" IsDefault="True" Click="Save_Click" Padding="16,7" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</Window>
