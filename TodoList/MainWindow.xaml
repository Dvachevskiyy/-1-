<Window x:Class="TodoList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todo List" Height="620" Width="1050" MinHeight="500" MinWidth="780">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <TextBlock Text="Todo List" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Add task" Click="AddTask_Click" Padding="18,8" Margin="8,0,0,0" />
                <Button Content="Save" Click="Save_Click" Padding="18,8" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
        <DataGrid x:Name="TasksGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="TasksGrid_SelectionChanged" CanUserAddRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" />
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=d}" Width="110" />
                <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=d}" Width="110" />
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="100" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                <DataGridTemplateColumn Header="Actions" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Edit" Click="EditTask_Click" Tag="{Binding}" Padding="10,4" />
                                <Button Content="Delete" Click="DeleteTask_Click" Tag="{Binding}" Padding="10,4" Margin="6,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
